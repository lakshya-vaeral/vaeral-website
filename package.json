{
  "name": "vaeral-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.js",
    "preview": "npx serve dist",
    "check": "node scripts/validate-schema.mjs && node scripts/check-content.mjs",
    "check:render": "node scripts/render-check.mjs",
    "verify": "npm run build && npm run check && npm run check:render",
    "health": "node scripts/health-check.mjs",
    "google:check": "node scripts/google-check.mjs",
    "report:analytics": "node scripts/analytics-report.mjs",
    "report:search": "node scripts/index-report.mjs",
    "google:authorize": "node scripts/google-authorize.mjs"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "dotenv": "^17.4.2",
    "front-matter": "^4.0.2",
    "marked": "^18.0.5",
    "nodemailer": "^9.0.3"
  }
}
